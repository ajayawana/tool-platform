---
import Layout from '../../../layouts/Layout.astro';
import { taxTools } from '../../../data/taxTools';
const base=import.meta.env.BASE_URL;
const title='Tax Calculators & Tax Planning Tools';
const description='Free global tax calculators for VAT, sales tax, effective tax rates, withholding, self-employed reserves, capital gains and business profit estimates.';
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:title,description,url:new URL(`${base}niche/tax/`,Astro.site||Astro.url).href};
---
<Layout title={`${title} | Ozarbox`} description={description}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<section class="container prose">
<div class="eyebrow">Tax · {taxTools.length} tools</div>
<h1>{title}</h1>
<p>{description} These tools are designed as transparent estimates. Tax rules differ by country, state, province, tax year, entity type and transaction, so every result should be checked against the applicable authority.</p>
<div class="tool-grid" style="margin-top:28px">{taxTools.map(t=><a class="card" href={`${base}niche/tax/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div>
<h2 style="margin-top:42px">How to use these tax tools</h2>
<p>Select the jurisdiction-specific rate or assumption that applies to your situation, enter figures from the same period, and review the assumptions before using the result for planning.</p>
<h2>Important tax disclaimer</h2>
<p>Ozarbox tax calculators are general planning tools, not tax advice. They do not determine your legal tax liability and cannot account for every exemption, deduction, threshold, filing rule or local requirement.</p>
</section>
</Layout>
