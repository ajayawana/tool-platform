---
import Layout from '../../../layouts/Layout.astro';
import k6 from '../../../data/source-assessment-k6.json';
import cesd from '../../../data/source-assessment-ces-d.json';
const base = import.meta.env.BASE_URL;
const scale = Astro.params.slug === 'k6' ? k6 : cesd;
const isCesd = scale.id === 'ces-d';
export function getStaticPaths() { return [{ params: { slug: 'k6' } }, { params: { slug: 'ces-d' } }]; }
---
<Layout title={scale.title + ' | Ozarbox'} description={'Source-based ' + scale.title + ' questionnaire and raw scoring.'}>
<section class="container assessment-tool">
<nav class="breadcrumbs"><a href={base}>Home</a> / <a href={base + 'assessments/'}>Assessment centre</a> / {scale.id.toUpperCase()}</nav>
<header><p class="eyebrow">Ozarbox · source-based implementation</p><h1>{scale.title}</h1><p class="lead">{scale.prompt}</p><p class="source-badge">✓ Official source used · free-use basis documented</p></header>
<aside class="notice"><h2>Use and interpretation limits</h2><p>{scale.useNotice}</p><p>{scale.scoringNote}</p></aside>
<form id="assessment-form" data-max={isCesd ? 3 : 4} data-total-max={isCesd ? 60 : 24} data-reverse={JSON.stringify(scale.reverseItems)}>
<fieldset class="response-key"><legend>Response options</legend><ol>{scale.responseOptions.map((o)=><li><strong>{o.value}</strong> — {o.label}</li>)}</ol><p>Answer every item.</p></fieldset>
{scale.questions.map((q,i)=><fieldset class="question"><legend><span>Item {i+1} of {scale.questions.length}</span>{q}</legend><div class="options">{scale.responseOptions.map((o)=><label><input type="radio" name={'item-'+(i+1)} value={o.value} required/><span>{o.value}</span></label>)}</div></fieldset>)}
<div class="actions"><button type="submit">Calculate raw score</button><button type="reset" class="secondary">Clear responses</button></div>
</form>
<section id="results" hidden aria-live="polite"><h2>Raw score</h2><p id="score" class="score"></p><p>Raw score only. No diagnosis or automated severity category is provided; interpretation depends on population and context.</p><p><strong>Source:</strong> {scale.sourceName}. {scale.citation}</p><p><a href={scale.sourceUrl} target="_blank" rel="noopener noreferrer">Open official source and use terms ↗</a></p><div class="actions"><button type="button" id="print">Print results</button><button type="button" id="edit" class="secondary">Edit responses</button></div></section>
</section>
<script>
const form=document.querySelector<HTMLFormElement>('#assessment-form');
const results=document.querySelector<HTMLElement>('#results');
const scoreEl=document.querySelector<HTMLElement>('#score');
form?.addEventListener('submit',(event)=>{event.preventDefault();const max=Number(form.dataset.max);const totalMax=Number(form.dataset.totalMax);const reverse=JSON.parse(form.dataset.reverse||'[]') as number[];const values=Array.from({length:form.querySelectorAll('.question').length},(_,i)=>{const el=form.querySelector<HTMLInputElement>('input[name="item-'+(i+1)+'"]:checked');return el?Number(el.value):NaN;});if(values.some(v=>!Number.isInteger(v)||v<0||v>max))return;if(totalMax===60)reverse.forEach(i=>{values[i-1]=max-values[i-1]});const total=values.reduce((a,b)=>a+b,0);if(scoreEl)scoreEl.textContent=total+' / '+totalMax;if(results)results.hidden=false;results?.scrollIntoView({behavior:'auto',block:'start'});});
form?.addEventListener('reset',()=>{if(results)results.hidden=true});
document.querySelector<HTMLButtonElement>('#edit')?.addEventListener('click',()=>{if(results)results.hidden=true;form?.scrollIntoView({behavior:'auto',block:'start'})});
document.querySelector<HTMLButtonElement>('#print')?.addEventListener('click',()=>window.print());
</script>
<style>
.assessment-tool{max-width:900px;padding:30px 0}.assessment-tool h1{font-size:clamp(2rem,5vw,3rem);line-height:1.1}.lead{font-size:1.1rem}.source-badge{display:inline-block;padding:5px 10px;border:1px solid #9ac5a4;border-radius:999px;background:#eefbf1;color:#166534;font-weight:800;font-size:.82rem}.notice{padding:18px;border:1px solid #f5d08a;border-radius:14px;background:#fffbeb;color:#78350f;margin:20px 0}.response-key,.question{padding:16px;border:1px solid #dbe3ee;border-radius:12px;margin:16px 0}.question legend{font-weight:700;line-height:1.5}.question legend span{display:block;color:#64748b;font-size:.8rem;font-weight:800}.options{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:14px}.options label{display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid #cbd5e1;border-radius:10px;padding:9px 4px;cursor:pointer}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.actions button{padding:12px 16px;border:0;border-radius:10px;background:#1d4ed8;color:white;font-weight:800;cursor:pointer}.actions .secondary{background:#e2e8f0;color:#334155}.score{font-size:2rem;font-weight:850}@media(max-width:600px){.options{grid-template-columns:repeat(3,minmax(0,1fr))}}@media print{.actions,form{display:none!important}}
</style>
</Layout>