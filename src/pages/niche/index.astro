---
import Layout from '../../layouts/Layout.astro';
import { nicheTools } from '../../data/nicheTools';
import { globalTools } from '../../data/globalTools';
import { accountingTools } from '../../data/accountingTools';
import { taxTools } from '../../data/taxTools';
import { professionalTools } from '../../data/professionalTools';
const base=import.meta.env.BASE_URL;
const allTools=[...nicheTools,...globalTools];
const grouped=allTools.reduce((acc,t)=>{(acc[t.cluster]??=[]).push(t);return acc;},{} as Record<string,typeof allTools>);
---
<Layout title="Niche Professional Calculators | Ozarbox" description="Free niche calculators for solar, EV, HVAC, construction, accounting, tax, professional services and industry-specific workflows.">
<section class="container prose"><div class="eyebrow">Professional tools</div><h1>Niche calculators built for real workflows</h1><p>Focused calculators for specific professional jobs, business decisions and industry workflows. Every tool is designed to be useful first, with transparent inputs and assumptions.</p>
<section style="margin-top:34px"><h2>Accounting</h2><div class="tool-grid">{accountingTools.map(t=><a class="card" href={`${base}niche/accounting/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>
<section style="margin-top:34px"><h2>Tax</h2><div class="tool-grid">{taxTools.map(t=><a class="card" href={`${base}niche/tax/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>
<section style="margin-top:34px"><h2>Professional services</h2><div class="tool-grid">{professionalTools.map(t=><a class="card" href={`${base}niche/professional-services/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>
{Object.entries(grouped).map(([cluster,items])=><section style="margin-top:34px"><h2><a href={`${base}niche/${cluster}/`}>{cluster.replaceAll('-',' ')}</a></h2><div class="tool-grid">{items.map(t=><a class="card" href={`${base}niche/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>)}
</section></Layout>
