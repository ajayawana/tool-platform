---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
---
<Layout title="Free Online Tools | ToolPlatform" description="Fast, free calculators and useful browser tools. No signup required.">
  <section class="hero container">
    <div class="eyebrow">Fast · Free · Private</div>
    <h1>Useful tools.<br />No unnecessary friction.</h1>
    <p>Simple calculators and utilities that run directly in your browser. No account required.</p>
    <div class="search-wrap"><input id="tool-search" type="search" placeholder={`Search ${tools.length} free tools...`} aria-label="Search tools" /></div>
  </section>
  <section class="container">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:20px"><div><div class="eyebrow">Calculator library</div><h2><span id="tool-count">{tools.length}</span> tools</h2></div><a href="/categories/">View categories →</a></div>
    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => <a class="card tool-card" data-search={`${tool.title} ${tool.description} ${tool.keywords.join(' ')}`} href={`/tools/${tool.slug}/`}><h3>{tool.title}</h3><p>{tool.description}</p></a>)}
    </div>
    <p id="no-results" hidden style="padding:30px 0;color:#6b7280">No tools matched your search.</p>
  </section>
</Layout>
<script define:vars={{ total: tools.length }}>
  const search = document.querySelector('#tool-search');
  const cards = [...document.querySelectorAll('.tool-card')];
  const count = document.querySelector('#tool-count');
  const empty = document.querySelector('#no-results');
  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const match = !q || (card.getAttribute('data-search') || '').toLowerCase().includes(q);
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = String(q ? visible : total);
    if (empty) empty.hidden = visible !== 0;
  });
</script>
