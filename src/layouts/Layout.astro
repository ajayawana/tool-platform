---
const { title = 'Ozarbox – Free Online Calculators & Professional Tools', description = 'Ozarbox provides free, practical online calculators and professional tools.', robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' } = Astro.props;
const base=import.meta.env.BASE_URL;
const siteRoot=Astro.site ?? Astro.url;
const stripBase=(path:string)=>path.startsWith(base)?path.slice(base.length):path;
const canonicalPath=(base.replace(/\/$/,'')+'/'+stripBase(Astro.url.pathname).replace(/^\//,'')).replace(/\/+/g,'/').replace(/\/$/,'')+'/';
const canonical=new URL(canonicalPath,siteRoot);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content={robots}><meta name="theme-color" content="#0f172a"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical.href}><link rel="icon" href={base+'favicon.svg'} type="image/svg+xml"><meta property="og:site_name" content="Ozarbox"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={canonical.href}><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Ozarbox',url:new URL(base,siteRoot).href,description})}></script></head>
<body><header class="site-header"><div class="container nav"><a class="brand" href={base}>Ozar<span>box</span></a><nav aria-label="Main navigation"><a href={base+'calculators/'}>Calculators</a><a href={base+'niche/'}>Professional</a><a href={base+'dairy/'}>Dairy</a><a href={base+'research/'}>Research</a><a class="nav-cta" href={base+'categories/'}>All tools</a></nav></div></header><main><slot /></main><footer><div class="container footer"><div><strong>Ozarbox</strong><p>Free tools made simple.</p></div><div class="footer-links"><a href={base+'categories/'}>All tools</a><a href={base+'privacy/'}>Privacy</a><a href={base+'terms/'}>Terms</a><a href={base+'disclaimer/'}>Disclaimer</a><a href={base+'contact/'}>Contact</a></div></div></footer></body></html>
<style is:global>
