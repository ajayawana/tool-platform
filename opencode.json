{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/openai/gpt-oss-120b",
  "small_model": "groq/openai/gpt-oss-120b",
  "provider": {
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT OSS 120B (quota-capped)",
          "limit": {
            "context": 6000,
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "steps": 12
    }
  },
  "permission": {
    "task": "deny",
    "websearch": "deny",
    "webfetch": "deny"
  }
}
