---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
import { nicheTools } from '../data/nicheTools';
import { globalTools } from '../data/globalTools';
import { accountingTools } from '../data/accountingTools';
import { taxTools } from '../data/taxTools';
import { professionalTools } from '../data/professionalTools';
import { dairyTools } from '../data/dairyTools';
import { researchTools } from '../data/researchTools';
const base=import.meta.env.BASE_URL;
const generic=tools.map(t=>({...t,href:base+'calculators/'+t.slug+'/',group:t.category}));
const industry=[...nicheTools,...globalTools].map(t=>({...t,href:base+'niche/'+t.slug+'/',group:t.cluster}));
const all=[...generic,...industry,...accountingTools.map(t=>({...t,href:base+'niche/accounting/'+t.slug+'/',group:'accounting'})),...taxTools.map(t=>({...t,href:base+'niche/tax/'+t.slug+'/',group:'tax'})),...professionalTools.map(t=>({...t,href:base+'niche/professional-services/'+t.slug+'/',group:'professional services'})),...dairyTools.map(t=>({...t,href:base+'dairy/'+t.slug+'/',group:'dairy & buffalo'})),...researchTools.map(t=>({...t,href:base+'research/'+t.slug+'/',group:'research'}))];
const cats=[
['🧮','Everyday calculators','Common calculations for money, maths, health, education and daily life.',base+'calculators/',generic.length],
['💰','Money & finance','Loans, interest, savings, ROI and money decisions.',base+'calculators/',generic.filter(t=>t.category==='finance').length],
['💼','Business','Profit, pricing, accounting, tax and service-business tools.',base+'niche/accounting/',accountingTools.length+taxTools.length+professionalTools.length],
['📐','Math & science','Geometry, equations, physics and science tools.',base+'calculators/',generic.filter(t=>['math','science'].includes(t.category)).length],
['❤️','Health & fitness','BMI, BMR, calories and everyday fitness calculations.',base+'calculators/',generic.filter(t=>t.category==='health').length],
['🎓','Education','GPA, grades and study planning.',base+'calculators/',generic.filter(t=>t.category==='education').length],
['🛠️','Professional & industry','Solar, EV, HVAC, construction and trade tools.',base+'niche/',industry.length],
['🐃','Dairy & buffalo','Feed, milk profit, break-even and farm planning.',base+'dairy/',dairyTools.length],
['🔎','Research','Specialized business and professional analysis.',base+'research/',researchTools.length]
];
const popular=[generic[0],generic[2],generic[10],generic[12],...industry.filter(t=>['solar-panel-payback-calculator','ev-charging-cost','concrete-slab-calculator','debt-service-coverage-ratio-calculator'].includes(t.slug))].filter(Boolean).slice(0,10);
---
<Layout title="Ozarbox – Free Online Calculators & Professional Tools" description="Free, practical calculators and professional tools for everyday life, money, business, construction, solar, EV, dairy and more.">
<section class="home-hero"><div class="container hero-inner"><div class="eyebrow">Ozarbox · Free tools</div><h1>Find the right calculator in seconds.</h1><p>Choose a category, search by what you need, or start with a popular tool. No maze of menus.</p><div class="big-search"><span>🔎</span><input id="tool-search" type="search" placeholder="What do you want to calculate?" aria-label="Search all tools"></div><div class="quick-links"><a href="#categories">Browse categories</a><a href="#popular">Popular tools</a><a href={base+'categories/'}>All {all.length} tools</a></div></div></section>
<section class="container section" id="categories"><div class="section-heading"><div><div class="eyebrow">Step 1</div><h2>What are you trying to do?</h2></div><span class="muted">{all.length} tools</span></div><div class="category-grid">{cats.map(c=><a class="category-card" href={String(c[3])}><div class="category-icon">{c[0]}</div><div><h3>{c[1]}</h3><p>{c[2]}</p><strong>{c[4]} tools →</strong></div></a>)}</div></section>
<section class="container section" id="popular"><div class="section-heading"><div><div class="eyebrow">Step 2</div><h2>Start with a popular tool</h2></div><a href={base+'categories/'}>See all →</a></div><div class="popular-grid">{popular.map(t=><a class="popular-card" href={t.href}><span class="popular-badge">FREE</span><h3>{t.title}</h3><p>{t.description}</p><span class="use-link">Open calculator →</span></a>)}</div></section>
<section class="container section" id="mental-wellbeing"><div class="section-heading"><div><div class="eyebrow">Mental wellbeing</div><h2>PHQ-9 symptom screening</h2></div><span class="muted">Private · Optional</span></div><a class="mental-health-card" href={base+'tools/phq-9/'}><span class="mental-health-icon" aria-hidden="true">💙</span><div><h3>Patient Health Questionnaire-9 (PHQ-9)</h3><p>Complete the nine-item symptom screening, see a deterministic score and severity band, and optionally compare score history on your own device. Your answers are processed in your browser.</p><strong>Start PHQ-9 screening →</strong><span class="mental-health-disclaimer">Screening only — not a diagnosis or a substitute for professional care.</span></div></a></section>
<section class="container section" id="search-section"><div class="section-heading"><div><div class="eyebrow">Step 3</div><h2>Search the complete library</h2></div><span class="muted" id="search-count">{all.length}</span></div><div class="search-results">{all.map(t=><a class="search-result" data-search={t.title+' '+t.description+' '+(t.keywords||[]).join(' ')+' '+t.group} href={t.href}><strong>{t.title}</strong><span>{t.group.replaceAll('-',' ')} · {t.description}</span></a>)}</div><p id="no-results" hidden class="empty-state">Nothing found. Try “loan”, “solar”, “tax”, “profit”, “milk” or “GPA”.</p></section>
<section class="container section"><div class="trust-box"><div><div class="eyebrow">Made for everyone</div><h2>Simple enough to use without instructions.</h2><p>Large labels, example values, clear buttons and one focused job per page.</p></div><a class="primary-button" href={base+'categories/'}>Browse everything</a></div></section>
<script>
const input=document.querySelector<HTMLInputElement>('#tool-search'),cards=[...document.querySelectorAll<HTMLElement>('.search-result')],count=document.querySelector<HTMLElement>('#search-count'),empty=document.querySelector<HTMLElement>('#no-results');
input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let n=0;cards.forEach(c=>{const ok=!q||(c.getAttribute('data-search')||'').toLowerCase().includes(q);c.hidden=!ok;if(ok)n++});if(count)count.textContent=String(n);if(empty)empty.hidden=n!==0;if(q)document.querySelector('#search-section')?.scrollIntoView({behavior:'smooth',block:'start'})});
</script>
</Layout>
<style>
.mental-health-card{display:flex;align-items:flex-start;gap:18px;padding:24px;border:1px solid #bfdbfe;border-radius:18px;background:linear-gradient(135deg,#eff6ff,#fff);text-decoration:none;color:inherit;max-width:900px}
.mental-health-card:hover{border-color:#60a5fa;box-shadow:0 10px 28px #0f172a10}
.mental-health-icon{font-size:2.2rem}
.mental-health-card h3{margin:0 0 8px;font-size:1.25rem}
.mental-health-card p{margin:0 0 12px;color:#475569}
.mental-health-card strong{display:block;color:#1d4ed8}
.mental-health-disclaimer{display:block;margin-top:10px;color:#64748b;font-size:.87rem}
@media(max-width:520px){.mental-health-card{padding:17px;gap:12px}.mental-health-icon{font-size:1.7rem}}
</style>
