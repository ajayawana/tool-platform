---
import Layout from '../../layouts/Layout.astro';
import { researchTools } from '../../data/researchTools';
const base=import.meta.env.BASE_URL;
export function getStaticPaths(){return researchTools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const related=researchTools.filter(t=>t.cluster===tool.cluster&&t.slug!==tool.slug).slice(0,6);
const schema={"@context":"https://schema.org","@graph":[{"@type":"WebApplication","name":tool.title,"applicationCategory":"BusinessApplication","operatingSystem":"Web","description":tool.description,"url":Astro.url.href,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":new URL(base,Astro.site||Astro.url).href},{"@type":"ListItem","position":2,"name":"Research tools","item":new URL(`${base}research/`,Astro.site||Astro.url).href},{"@type":"ListItem","position":3,"name":tool.cluster.replaceAll('-',' '),"item":new URL(`${base}research/cluster/${tool.cluster}/`,Astro.site||Astro.url).href},{"@type":"ListItem","position":4,"name":tool.title,"item":Astro.url.href}]}]};
---
<Layout title={`${tool.title} | Free Online Tool | Ozarbox`} description={`${tool.description} Free calculator with transparent assumptions, examples and related professional tools.`}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<main class="container tool-wrap">
<div class="breadcrumbs"><a href={base}>Home</a> / <a href={`${base}research/`}>Research tools</a> / {tool.cluster.replaceAll('-',' ')} / {tool.title}</div>
<header class="tool-head"><div class="eyebrow">{tool.cluster.replaceAll('-',' ')}</div><h1>{tool.title}</h1><p>{tool.description}</p></header>
<section class="tool-box" aria-label={tool.title}><div class="form-grid">{tool.inputs.map(input=><label>{input.label}{input.unit&&<small> ({input.unit})</small>}<input data-key={input.key} type="number" inputmode="decimal" placeholder={input.placeholder}/></label>)}</div><button id="calculate">Calculate</button><div class="result" id="result" aria-live="polite">Enter your values and tap Calculate.</div></section>
<article class="prose" style="max-width:860px;margin:24px auto 0"><h2>How this calculator works</h2><p>{tool.description} Enter your own assumptions instead of relying on the examples. The calculator shows the arithmetic openly so you can audit the result.</p><h2>Assumptions and limitations</h2><p>{tool.note}</p><h2>Example</h2><p>The input boxes contain illustrative values. Change one assumption at a time to understand which variable has the largest effect on the result.</p><h2>Important professional note</h2><p>Ozarbox calculators are planning and estimation tools. They do not replace a contract review, tax determination, engineering calculation, medical decision, freight classification, employment-law analysis or other required professional determination.</p><h2>Frequently asked questions</h2><h3>Is this calculator free?</h3><p>Yes. The calculation runs in your browser and no payment is required.</p><h3>Can I use the result for a business decision?</h3><p>You can use it as a planning input. Verify material assumptions and applicable rules before making a consequential decision.</p><h3>Why can my result differ from another calculator?</h3><p>Different calculators may use different assumptions, time periods, definitions or jurisdiction-specific rules. Compare the assumptions rather than treating one number as universally correct.</p></article>
{related.length>0&&<section style="margin-top:42px"><h2>Related {tool.cluster.replaceAll('-',' ')} tools</h2><div class="tool-grid">{related.map(t=><a class="card" href={`${base}research/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>}
<section style="margin-top:42px"><h2>Explore Ozarbox tools</h2><div class="tool-grid"><a class="card" href={`${base}niche/accounting/`}><strong>Accounting tools</strong><span>Margins, working capital, DSCR and cash-cycle tools.</span></a><a class="card" href={`${base}niche/tax/`}><strong>Tax tools</strong><span>VAT, GST and tax-planning estimates.</span></a><a class="card" href={`${base}niche/professional-services/`}><strong>Professional services</strong><span>Pricing and profitability calculators.</span></a><a class="card" href={`${base}niche/`}><strong>Construction & trade tools</strong><span>Browse construction and professional trade calculators.</span></a></div></section>
</main></Layout>
<script define:vars={{formula:tool.formula}}>
const $=(s)=>document.querySelector(s);const button=$('#calculate');const result=$('#result');
const num=(k)=>Number(document.querySelector(`[data-key="${k}"]`)?.value||0);const has=(keys)=>keys.every(k=>{const v=document.querySelector(`[data-key="${k}"]`)?.value;return v!==''&&v!=null});
const f=(x)=>Number.isFinite(x)?x.toLocaleString(undefined,{maximumFractionDigits:2}):'N/A';const money=(x)=>Number.isFinite(x)?x.toLocaleString(undefined,{style:'currency',currency:'USD',maximumFractionDigits:2}):'N/A';
button?.addEventListener('click',()=>{let out='Enter all required values.';
if(formula==='latePayment'&&has(['invoice','rate','days'])){const cost=num('invoice')*num('rate')/100*num('days')/365;out=`Estimated financing / late-cost impact: ${money(cost)}`;}
else if(formula==='turnover'&&has(['salary','benefits','recruiting','training','vacancy','dailyContribution'])){const loaded=num('salary')*(1+num('benefits')/100);const vacancyCost=num('vacancy')*num('dailyContribution');const total=loaded*num('vacancy')/365+num('recruiting')+num('training')+vacancyCost;out=`Estimated replacement cost: ${money(total)}`;}
else if(formula==='tenantTurnover'&&has(['rent','vacancy','repairs','leasing','concession'])){const vacancyCost=num('rent')*num('vacancy')/30;const total=vacancyCost+num('repairs')+num('leasing')+num('concession');out=`Estimated tenant turnover cost: ${money(total)} | Vacancy portion: ${money(vacancyCost)}`;}
else if(formula==='materialWaste'&&has(['quantity','unitCost','waste'])){const extra=num('quantity')*num('waste')/100;out=`Extra material: ${f(extra)} units | Waste cost: ${money(extra*num('unitCost'))}`;}
else if(formula==='changeOrder'&&has(['revenue','labor','materials','subcontract','overhead'])){const cost=num('labor')+num('materials')+num('subcontract')+num('overhead');const profit=num('revenue')-cost;out=`Change-order profit: ${money(profit)} | Margin: ${f(profit/num('revenue')*100)}%`;}
else if(formula==='overtimeBurden'&&has(['workers','hours','wage','multiplier','burden'])){const direct=num('workers')*num('hours')*num('wage')*num('multiplier');const total=direct*(1+num('burden')/100);out=`Loaded overtime cost: ${money(total)} | Direct overtime wages: ${money(direct)}`;}
else if(formula==='retainage'&&has(['invoice','retainage','delay','financing'])){const held=num('invoice')*num('retainage')/100;const cost=held*num('financing')/100*num('delay')/12;out=`Cash withheld: ${money(held)} | Estimated financing cost of delay: ${money(cost)}`;}
else if(formula==='sponsor'&&has(['hours','rate','revisions','usage','exclusivity'])){const base=(num('hours')+num('revisions'))*num('rate');out=`Planning fee: ${money(base+num('usage')+num('exclusivity'))}`;}
else if(formula==='usageRights'&&has(['creation','months','monthlyRate','exclusivity'])){const usage=num('creation')*num('monthlyRate')/100*num('months');const exclusive=num('creation')*num('exclusivity')/100;out=`Estimated usage-rights add-on: ${money(usage+exclusive)} | Total: ${money(num('creation')+usage+exclusive)}`;}
else if(formula==='barter'&&has(['cash','product','discount','hours','hourValue'])){const realistic=num('product')*(1-num('discount')/100);const labor=num('hours')*num('hourValue');out=`Realistic product value: ${money(realistic)} | Time value: ${money(labor)} | Cash alternative: ${money(num('cash'))}`;}
else if(formula==='podcastCpm'&&has(['downloads','fill','cpm','ads','episodes'])){const monthly=num('downloads')*num('fill')/100*num('cpm')/1000*num('ads')*num('episodes');out=`Estimated monthly gross ad revenue: ${money(monthly)}`;}
else if(formula==='scorpComp'&&has(['marketSalary','responsibility','time','serviceRevenue'])){const benchmark=num('marketSalary')*(1+num('responsibility')/100)*(num('time')/100);out=`Planning compensation benchmark: ${money(benchmark)} | Personal-service revenue entered: ${money(num('serviceRevenue'))}`;}
else if(formula==='boot1031'&&has(['sale','basis','sellingCosts','boot'])){const gain=Math.max(0,num('sale')-num('basis')-num('sellingCosts'));const recognized=Math.min(gain,num('boot'));out=`Estimated realized gain: ${money(gain)} | Potential recognized gain from entered boot: ${money(recognized)}`;}
else if(formula==='freightDensity'&&has(['weight','length','width','height'])){const volume=num('length')*num('width')*num('height')/1728;const density=num('weight')/volume;out=`Freight density: ${f(density)} lb/ft³ | Shipment volume: ${f(volume)} ft³`;}
else if(formula==='wrvu'&&has(['wrvus','conversion','base'])){const productivity=num('wrvus')*num('conversion');out=`wRVU-based variable compensation: ${money(productivity)} | Base + variable: ${money(num('base')+productivity)}`;}
result.textContent=out;});
</script>
