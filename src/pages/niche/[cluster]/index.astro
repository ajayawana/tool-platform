---
import Layout from '../../../layouts/Layout.astro';
import { nicheTools } from '../../../data/nicheTools';
import { globalTools } from '../../../data/globalTools';
const allTools=[...nicheTools,...globalTools];
const clusters=[...new Set(allTools.map(t=>t.cluster))];
export function getStaticPaths(){return clusters.map(cluster=>({params:{cluster},props:{cluster,items:allTools.filter(t=>t.cluster===cluster)}}));}
const {cluster,items}=Astro.props;
const label=cluster.replaceAll('-',' ');
const title=`${label} calculators & professional tools`;
---
<Layout title={`${title} | ToolPlatform`} description={`Free ${label} calculators and professional planning tools. Fast, browser-based and designed for practical estimates.`}>
<section class="container prose"><div class="eyebrow">Niche tools</div><h1>{title}</h1><p>Purpose-built tools for a specific workflow. Each calculator explains the inputs, assumptions and calculation so you can adapt it to your project, market and local requirements.</p><div class="tool-grid" style="margin-top:28px">{items.map(t=><a class="card" href={`/niche/${t.slug}`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div><h2 style="margin-top:42px">How to use these tools</h2><p>Start with the calculator that matches the job you are doing, enter your real project assumptions, then use the related tools on the result page to cross-check the decision. For regulated work, verify the estimate against current official rules, standards, contracts and manufacturer documentation.</p><h2>Explore another professional cluster</h2><div class="tool-grid">{clusters.filter(c=>c!==cluster).slice(0,8).map(c=><a class="card" href={`/niche/${c}/`}><strong>{c.replaceAll('-',' ')}</strong><span>Browse focused tools for {c.replaceAll('-',' ')}.</span></a>)}</div></section>
</Layout>
