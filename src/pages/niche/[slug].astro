---
import Layout from '../../layouts/Layout.astro';
import { nicheTools } from '../../data/nicheTools';
export function getStaticPaths(){return nicheTools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const related=nicheTools.filter(t=>t.cluster===tool.cluster&&t.slug!==tool.slug).slice(0,5);
---
<Layout title={`${tool.title} | ToolPlatform`} description={tool.description}>
<section class="tool-wrap container">
<div class="breadcrumbs"><a href="/">Home</a> / <a href={`/niche/${tool.cluster}/`}>{tool.cluster.replaceAll('-',' ')}</a> / {tool.title}</div>
<div class="tool-head"><div class="eyebrow">{tool.cluster.replaceAll('-',' ')}</div><h1>{tool.title}</h1><p>{tool.description}</p></div>
<div class="tool-box"><div class="form-grid">{tool.inputs.map(input=><label>{input.label}{input.unit&&<small> ({input.unit})</small>}<input data-key={input.key} type="number" inputmode="decimal" placeholder={input.placeholder}/></label>)}</div><button id="calculate">Calculate</button><div class="result" id="result" aria-live="polite">Enter your values and tap Calculate.</div></div>
<article class="prose" style="max-width:820px;margin-top:34px"><h2>How this {tool.title.toLowerCase()} works</h2><p>Enter the assumptions that match your project, then review the estimate. This tool is intended for planning and comparison; local codes, tariffs, engineering requirements, tax rules and manufacturer specifications can change the correct inputs.</p><h2>Use the result intelligently</h2><p>For professional work, verify the assumptions before purchasing materials, signing a quote, approving a design or making a compliance decision. Where standards or local rules apply, use the current official requirements.</p></article>
{related.length>0&&<section style="margin-top:38px"><h2>More {tool.cluster.replaceAll('-',' ')} tools</h2><div class="tool-grid">{related.map(t=><a class="card" href={`/niche/${t.slug}`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>}
</section>
</Layout>
<script define:vars={{inputs:tool.inputs,formula:tool.formula}}>
const $=(s)=>document.querySelector(s); const button=$('#calculate'); const result=$('#result');
const num=(k)=>Number(document.querySelector(`[data-key="${k}"]`)?.value||0); const has=(keys)=>keys.every(k=>{const v=document.querySelector(`[data-key="${k}"]`)?.value;return v!==''&&v!=null});
const f=(x)=>Number.isFinite(x)?x.toLocaleString(undefined,{maximumFractionDigits:2}):'N/A'; const money=(x)=>f(x);
button?.addEventListener('click',()=>{let out='Enter all required values.';
if(formula==='solarPayback'&&has(['cost','incentive','annual','maintenance'])){const net=num('cost')-num('incentive');out=num('annual')>num('maintenance')?`Estimated payback: ${f(net/(num('annual')-num('maintenance')))} years`:'Annual savings must exceed maintenance.'}
else if(formula==='batterySize'&&has(['daily','hours','dod','eff']))out=`Estimated battery nameplate: ${f(num('daily')*num('hours')/24/(num('dod')/100)/(num('eff')/100))} kWh`;
else if(formula==='solarRoi'&&has(['cost','annual']))out=num('cost')>0?`Simple annual ROI: ${f(num('annual')/num('cost')*100)}%`:'Cost must be above 0.';
else if(formula==='panelCount'&&has(['size','panel']))out=num('panel')>0?`Estimated panels: ${Math.ceil(num('size')*1000/num('panel'))}`:'Panel rating must be above 0.';
else if(formula==='inverterSize'&&has(['array','ratio']))out=num('ratio')>0?`Estimated inverter size: ${f(num('array')/num('ratio'))} kW`:'Ratio must be above 0.';
else if(formula==='solarSavings'&&has(['generation','rate']))out=`Estimated annual savings: ${money(num('generation')*num('rate'))}`;
else if(formula==='evChargeCost'&&has(['battery','start','target','rate','loss']))out=`Energy from grid: ${f(num('battery')*(num('target')-num('start'))/100/(1-num('loss')/100))} kWh | Cost: ${money(num('battery')*(num('target')-num('start'))/100/(1-num('loss')/100)*num('rate'))}`;
else if(formula==='evCharger'&&has(['range','eff','hours']))out=num('hours')>0?`Required average charger power: ${f(num('range')/100*num('eff')/num('hours'))} kW`:'Hours must be above 0.';
else if(formula==='evTrip'&&has(['distance','eff','usable']))out=`Trip energy: ${f(num('distance')/100*num('eff'))} kWh | Idealized full-battery equivalents: ${f(num('distance')/100*num('eff')/num('usable'))}`;
else if(formula==='evVsPetrol'&&has(['ev','electric','petrol','mileage']))out=`EV: ${money(num('ev')/100*num('electric'))}/100 km | Petrol: ${money(num('petrol')/num('mileage')*100)}/100 km`;
else if(formula==='batteryDegradation'&&has(['capacity','rate','years']))out=`Estimated remaining capacity: ${f(num('capacity')*Math.pow(1-num('rate')/100,num('years')))} kWh`;
else if(formula==='evTime'&&has(['capacity','start','target','power','eff']))out=num('power')>0?`Estimated charging time: ${f((num('capacity')*(num('target')-num('start'))/100)/(num('power')*(num('eff')/100)))} hours`:'Power must be above 0.';
else if(formula==='acSize'&&has(['area','height','factor','climate']))out=`Estimated cooling load: ${f(num('area')*num('factor')*num('climate')*num('height')/10)} BTU/h | Approx. tons: ${f(num('area')*num('factor')*num('climate')*num('height')/10/12000)}`;
else if(formula==='acCost'&&has(['power','hours','days','rate']))out=`Estimated monthly energy: ${f(num('power')*num('hours')*num('days'))} kWh | Cost: ${money(num('power')*num('hours')*num('days')*num('rate'))}`;
else if(formula==='acRunning'&&has(['power','hours','rate']))out=`Daily cost: ${money(num('power')*num('hours')*num('rate'))} | Monthly (30 days): ${money(num('power')*num('hours')*num('rate')*30)}`;
else if(formula==='heatPump'&&has(['heat','cop','electric']))out=num('cop')>0?`Estimated heat-pump electricity cost: ${money(num('heat')/num('cop')*num('electric'))}`:'COP must be above 0.';
else if(formula==='airflow'&&has(['volume','ach']))out=`Required airflow: ${f(num('volume')*num('ach')/60)} CFM`;
else if(formula==='ductArea'&&has(['cfm','velocity']))out=num('velocity')>0?`Required duct area: ${f(num('cfm')/num('velocity'))} sq ft`:'Velocity must be above 0.';
else if(formula==='slab'&&has(['length','width','thickness','waste']))out=`Concrete: ${f(num('length')*num('width')*(num('thickness')/12)*(1+num('waste')/100)/27)} yd³`;
else if(formula==='footing'&&has(['count','length','width','depth']))out=`Concrete: ${f(num('count')*num('length')*num('width')*num('depth')/27)} yd³`;
else if(formula==='paint'&&has(['area','coverage','coats','waste']))out=num('coverage')>0?`Paint required: ${f(num('area')*num('coats')/num('coverage')*(1+num('waste')/100))} L`:'Coverage must be above 0.';
else if(formula==='tiles'&&has(['area','tileArea','waste']))out=num('tileArea')>0?`Tiles required: ${Math.ceil(num('area')/num('tileArea')*(1+num('waste')/100))}`:'Tile area must be above 0.';
else if(formula==='bricks'&&has(['area','bricks','waste']))out=`Estimated bricks: ${Math.ceil(num('area')*num('bricks')*(1+num('waste')/100))}`;
else if(formula==='boardFeet'&&has(['thickness','width','length','pieces']))out=`Board feet: ${f(num('thickness')*num('width')*num('length')*num('pieces')/12)}`;
else if(formula==='gst'&&has(['value','rate']))out=`GST: ${money(num('value')*num('rate')/100)} | Invoice total: ${money(num('value')*(1+num('rate')/100))}`;
else if(formula==='gstReverse'&&has(['price','rate']))out=num('rate')>-100?`Taxable value: ${money(num('price')/(1+num('rate')/100))} | GST: ${money(num('price')-num('price')/(1+num('rate')/100))}`:'Invalid rate.';
else if(formula==='breakEven'&&has(['fixed','price','variable']))out=num('price')>num('variable')?`Break-even units: ${f(num('fixed')/(num('price')-num('variable')))}`:'Selling price must exceed variable cost.';
else if(formula==='taxReserve'&&has(['income','rate','expenses']))out=`Estimated taxable base: ${money(Math.max(0,num('income')-num('expenses')))} | Reserve: ${money(Math.max(0,num('income')-num('expenses'))*num('rate')/100)}`;
else if(formula==='lateFee'&&has(['invoice','rate','days']))out=`Estimated late fee: ${money(num('invoice')*num('rate')/100*num('days')/365)}`;
else if(formula==='orderProfit'&&has(['revenue','product','shipping','fees','ads']))out=`Profit/order: ${money(num('revenue')-num('product')-num('shipping')-num('fees')-num('ads'))}`;
else if(formula==='voltageDrop'&&has(['current','resistance','length','phase']))out=`Estimated voltage drop: ${f(num('current')*num('resistance')*num('length')*num('phase'))} V`;
else if(formula==='powerFactor'&&has(['kw','kva']))out=num('kva')>0?`Power factor: ${f(num('kw')/num('kva'))}`:'kVA must be above 0.';
else if(formula==='pipeFlow'&&has(['diameter','velocity']))out=`Estimated flow: ${f(Math.PI*Math.pow(num('diameter')/1000,2)/4*num('velocity')*1000)} L/s`;
else if(formula==='conduit'&&has(['wires','area','conduit']))out=num('conduit')>0?`Conduit fill: ${f(num('wires')*num('area')/num('conduit')*100)}%`:'Conduit area must be above 0.';
else if(formula==='labor'&&has(['workers','hours','wage','overhead']))out=`Loaded labor cost: ${money(num('workers')*num('hours')*num('wage')*(1+num('overhead')/100))}`;
else if(formula==='mulch'&&has(['area','depth']))out=`Mulch volume: ${f(num('area')*num('depth')/12/27)} yd³`;
else if(formula==='toiletWater'&&has(['people','flushes','old','new','days']))out=`Old use: ${f(num('people')*num('flushes')*num('old')*num('days'))} L | New use: ${f(num('people')*num('flushes')*num('new')*num('days'))} L | Savings: ${f(num('people')*num('flushes')*(num('old')-num('new'))*num('days'))} L`;
else if(formula==='septic'&&has(['people','waste','retention']))out=`Planning tank volume: ${f(num('people')*num('waste')*num('retention')/1000)} m³`;
else if(formula==='drainfield'&&has(['flow','loading']))out=num('loading')>0?`Estimated area: ${f(num('flow')/num('loading'))} m²`:'Loading rate must be above 0.';
else if(formula==='paper'&&has(['people','uses','sheets','sheetsRoll','price','days']))out=num('sheetsRoll')>0?`Estimated rolls: ${f(num('people')*num('uses')*num('sheets')*num('days')/num('sheetsRoll'))} | Cost: ${money(num('people')*num('uses')*num('sheets')*num('days')/num('sheetsRoll')*num('price'))}`:'Sheets/roll must be above 0.';
else if(formula==='greywater'&&has(['people','litres']))out=`Estimated greywater: ${f(num('people')*num('litres'))} L/day`;
else if(formula==='waterTank'&&has(['people','daily','reserve']))out=`Recommended storage estimate: ${f(num('people')*num('daily')*num('reserve'))} L`;
result.textContent=out;});
</script>
