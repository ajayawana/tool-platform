---
const { title = 'Tool Platform', description = 'Fast, free online tools that work directly in your browser.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
</head>
<body>
  <header class="site-header"><div class="container nav"><a class="brand" href="/">Tool<span>Platform</span></a><nav><a href="/">Home</a><a href="/categories/">Categories</a><a href="/about/">About</a></nav></div></header>
  <main>{Astro.slots.default()}</main>
  <footer><div class="container footer"><div><strong>ToolPlatform</strong><p>Simple, fast, free browser tools.</p></div><div class="footer-links"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a><a href="/contact/">Contact</a></div></div></footer>
</body>
</html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#111827;background:#f8fafc}*{box-sizing:border-box}body{margin:0;line-height:1.6}.container{width:min(1120px,calc(100% - 32px));margin:auto}.site-header{background:#fff;border-bottom:1px solid #e5e7eb;position:sticky;top:0;z-index:10}.nav{height:68px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:800;font-size:1.25rem;color:#111827;text-decoration:none}.brand span{color:#2563eb}.nav nav{display:flex;gap:22px}.nav a{color:#374151;text-decoration:none}.nav nav a:hover{color:#2563eb}footer{margin-top:80px;background:#111827;color:#d1d5db}.footer{padding:36px 0;display:flex;justify-content:space-between;gap:30px}.footer p{margin:.25rem 0 0;color:#9ca3af}.footer-links{display:flex;gap:18px;flex-wrap:wrap}.footer-links a{color:#d1d5db;text-decoration:none}.hero{padding:72px 0 42px;text-align:center}.hero h1{font-size:clamp(2.2rem,6vw,4rem);line-height:1.05;margin:0 0 18px}.hero p{max-width:680px;margin:auto;color:#6b7280;font-size:1.1rem}.tools-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;padding:25px 0}.card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:22px;text-decoration:none;color:inherit;transition:.15s}.card:hover{transform:translateY(-2px);border-color:#93c5fd;box-shadow:0 8px 24px #0000000d}.card h2,.card h3{margin:0 0 8px;font-size:1.1rem}.card p{margin:0;color:#6b7280;font-size:.94rem}.eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.78rem;color:#2563eb;font-weight:700}.tool-wrap{padding:54px 0}.tool-head{max-width:760px}.tool-head h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.1;margin:.3rem 0 12px}.tool-head p{color:#6b7280}.tool-box{margin-top:28px;background:#fff;border:1px solid #e5e7eb;border-radius:20px;padding:28px;max-width:760px}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}label{display:grid;gap:7px;font-weight:650}input{width:100%;padding:12px 13px;border:1px solid #d1d5db;border-radius:10px;font:inherit}button{margin-top:20px;padding:12px 18px;border:0;border-radius:10px;background:#2563eb;color:white;font:inherit;font-weight:700;cursor:pointer}.result{margin-top:20px;padding:16px;border-radius:12px;background:#eff6ff;color:#1e3a8a;font-weight:700;min-height:28px}.breadcrumbs{font-size:.9rem;color:#6b7280;margin-bottom:25px}.prose{max-width:780px;padding:50px 0}.prose h1{font-size:2.5rem}.prose h2{margin-top:2rem}@media(max-width:640px){.nav nav{gap:10px;font-size:.9rem}.footer{flex-direction:column}.hero{padding-top:48px}}
</style>
