---
import Layout from '../../../../layouts/Layout.astro';
import { accountingTools } from '../../../../data/accountingTools';
const base=import.meta.env.BASE_URL;
export function getStaticPaths(){return accountingTools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const related=accountingTools.filter(t=>t.slug!==tool.slug).slice(0,6);
const exampleValues=tool.inputs.map(i=>i.placeholder).join(', ');
const title=`${tool.title} | Free Accounting Calculator`;
const description=`${tool.description} Free browser calculator with transparent formulas, assumptions, examples and related accounting tools.`;
const schema={"@context":"https://schema.org","@graph":[{"@type":"WebApplication","name":tool.title,"applicationCategory":"BusinessApplication","operatingSystem":"Web","description":tool.description,"url":new URL(`${base}niche/accounting/${tool.slug}/`,Astro.site||Astro.url).href,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":new URL(base,Astro.site||Astro.url).href},{"@type":"ListItem","position":2,"name":"Accounting","item":new URL(`${base}niche/accounting/`,Astro.site||Astro.url).href},{"@type":"ListItem","position":3,"name":tool.title,"item":new URL(`${base}niche/accounting/${tool.slug}/`,Astro.site||Astro.url).href}]}]};
---
<Layout title={`${title} | Ozarbox`} description={description}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<section class="tool-wrap container">
<div class="breadcrumbs"><a href={base}>Home</a> / <a href={`${base}niche/accounting/`}>Accounting</a> / {tool.title}</div>
<div class="tool-head"><div class="eyebrow">Accounting calculator</div><h1>{tool.title}</h1><p>{tool.description}</p></div>
<div class="tool-box"><div class="form-grid">{tool.inputs.map(input=><label>{input.label}{input.unit&&<small> ({input.unit})</small>}<input data-key={input.key} type="number" inputmode="decimal" placeholder={input.placeholder}/></label>)}</div><button id="calculate">Calculate</button><div class="result" id="result" aria-live="polite">Enter your values and tap Calculate.</div></div>
<article class="prose" style="max-width:820px;margin-top:20px"><h2>How this {tool.title.toLowerCase()} works</h2><p>This calculator applies a transparent accounting formula to the values you provide. The result is an estimate for analysis and planning; it is not a substitute for your accounting records or a formal financial statement calculation.</p><h2>Assumptions</h2><ul>{tool.inputs.map(i=><li><strong>{i.label}:</strong> replace the example with figures from the same reporting period and accounting basis.</li>)}</ul><h2>Example</h2><p>Try the example values ({exampleValues}) and change one input at a time. This makes it easier to see which variable drives the result.</p><h2>When verification is needed</h2><p>Definitions can vary by accounting framework, lender, contract and reporting policy. Verify important figures against the applicable accounting standards, lender methodology or qualified accountant.</p><h2>Frequently asked questions</h2><div><h3>What does this calculator provide?</h3><p>{tool.description}</p></div><div><h3>Are the calculations free?</h3><p>Yes. The calculator runs in the browser without a paid subscription.</p></div><div><h3>Can I use the result for financial reporting?</h3><p>Use it as an analysis and planning aid. Formal reporting should follow the accounting framework and policies applicable to your business.</p></div></article>
<section style="margin-top:38px"><h2>Related accounting tools</h2><div class="tool-grid">{related.map(t=><a class="card" href={`${base}niche/accounting/${t.slug}/`}><strong>{t.title}</strong><span>{t.description}</span></a>)}</div></section>
</section>
</Layout>
<script define:vars={{formula:tool.formula}}>
const $=(s)=>document.querySelector(s);const button=$('#calculate');const result=$('#result');const num=(k)=>Number(document.querySelector(`[data-key="${k}"]`)?.value||0);const has=(keys)=>keys.every(k=>{const v=document.querySelector(`[data-key="${k}"]`)?.value;return v!==''&&v!=null});const f=(x)=>Number.isFinite(x)?x.toLocaleString(undefined,{maximumFractionDigits:2}):'N/A';const money=(x)=>f(x);button?.addEventListener('click',()=>{let out='Enter all required values.';
if(formula==='workingCapital'&&has(['assets','liabilities']))out=`Net working capital: ${money(num('assets')-num('liabilities'))}`;
else if(formula==='currentRatio'&&has(['assets','liabilities']))out=`Current ratio: ${f(num('assets')/num('liabilities'))}x`;
else if(formula==='quickRatio'&&has(['cash','receivables','liabilities']))out=`Quick ratio: ${f((num('cash')+num('receivables'))/num('liabilities'))}x`;
else if(formula==='ccc'&&has(['inventory','receivables','payables']))out=`Cash conversion cycle: ${f(num('inventory')+num('receivables')-num('payables'))} days`;
else if(formula==='inventoryTurnover'&&has(['cogs','inventory','days']))out=`Inventory turnover: ${f(num('cogs')/num('inventory'))}x | Inventory days: ${f(num('inventory')/num('cogs')*num('days'))} days`;
else if(formula==='dso'&&has(['receivables','sales','days']))out=`Days sales outstanding: ${f(num('receivables')/num('sales')*num('days'))} days`;
else if(formula==='dpo'&&has(['payables','purchases','days']))out=`Days payable outstanding: ${f(num('payables')/num('purchases')*num('days'))} days`;
else if(formula==='de'&&has(['debt','equity']))out=`Debt-to-equity ratio: ${f(num('debt')/num('equity'))}x`;
else if(formula==='dscr'&&has(['income','service']))out=`DSCR: ${f(num('income')/num('service'))}x`;
else if(formula==='breakEvenRevenue'&&has(['fixed','margin']))out=`Break-even revenue: ${money(num('fixed')/(num('margin')/100))}`;
else if(formula==='depreciation'&&has(['cost','salvage','life','age'])){const annual=(num('cost')-num('salvage'))/num('life');const book=Math.max(num('salvage'),num('cost')-annual*num('age'));out=`Annual depreciation: ${money(annual)} | Estimated book value: ${money(book)}`}
else if(formula==='loanPayment'&&has(['principal','rate','years'])){const r=num('rate')/100/12;const months=num('years')*12;const p=num('principal');const payment=r===0?p/months:p*r*Math.pow(1+r,months)/(Math.pow(1+r,months)-1);out=`Monthly payment: ${money(payment)} | Total interest: ${money(payment*months-p)}`}
result.textContent=out;});
</script>
