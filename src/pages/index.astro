---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
import { nicheTools } from '../data/nicheTools';
import { globalTools } from '../data/globalTools';
import { accountingTools } from '../data/accountingTools';
const base = import.meta.env.BASE_URL;
const allTools=[...tools,...nicheTools,...globalTools];
const clusters=[...new Set([...nicheTools,...globalTools].map(t=>t.cluster))].sort();
---
<Layout title="Ozarbox – Free Online Calculators & Professional Tools" description="Free, practical and easy-to-use online calculators and professional tools for accounting, tax, construction, solar, EV, business and everyday decisions.">
<section class="hero container">
<div class="eyebrow">Fast · Free · Focused</div>
<h1>Useful tools for real-world decisions.</h1>
<p>Purpose-built calculators and professional utilities that run directly in your browser. Clear inputs, transparent assumptions and related tools—without unnecessary friction.</p>
<div class="search-wrap"><input id="tool-search" type="search" placeholder={`Search ${allTools.length} free tools...`} aria-label="Search tools" /></div>
</section>
<section class="container">
<div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap"><div><div class="eyebrow">Ozarbox tool library</div><h2><span id="tool-count">{allTools.length}</span> tools</h2></div><a href={`${base}niche/`}>Browse professional clusters →</a></div>
<div class="tools-grid" id="tools-grid">
{allTools.map(tool => <a class="card tool-card" data-search={`${tool.title} ${tool.description} ${tool.keywords.join(' ')}`} href={`${base}niche/${tool.slug}/`}><h3>{tool.title}</h3><p>{tool.description}</p></a>)}
</div>
<p id="no-results" hidden style="padding:30px 0;color:#6b7280">No tools matched your search.</p>
</section>
<section class="container" style="padding:50px 0">
<div class="eyebrow">Professional clusters</div><h2>Find tools by job or industry</h2>
<div class="tools-grid">{clusters.map(c=><a class="card" href={`${base}niche/${c}/`}><h3>{c.replaceAll('-',' ')}</h3><p>{[...nicheTools,...globalTools].filter(t=>t.cluster===c).length} focused tools</p></a>)}<a class="card" href={`${base}niche/accounting/`}><h3>Accounting</h3><p>{accountingTools.length} focused accounting tools</p></a></div>
</section>
<section class="container" style="padding:20px 0 50px">
<div class="eyebrow">New cluster</div><h2>Accounting & business finance</h2>
<p>Explore working capital, liquidity, cash conversion, inventory, receivables, leverage, DSCR, depreciation and business loan calculations.</p>
<div class="tool-grid">{accountingTools.slice(0,6).map(tool=><a class="card" href={`${base}niche/accounting/${tool.slug}/`}><strong>{tool.title}</strong><span>{tool.description}</span></a>)}</div>
<p style="margin-top:20px"><a href={`${base}niche/accounting/`}>Explore all accounting tools →</a></p>
</section>
</Layout>
<script define:vars={{ total: allTools.length }}>
const search=document.querySelector('#tool-search');
const cards=[...document.querySelectorAll('.tool-card')];
const count=document.querySelector('#tool-count');
const empty=document.querySelector('#no-results');
search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();let visible=0;cards.forEach(card=>{const match=!q||(card.getAttribute('data-search')||'').toLowerCase().includes(q);card.hidden=!match;if(match)visible++;});if(count)count.textContent=String(q?visible:total);if(empty)empty.hidden=visible!==0;});
</script>