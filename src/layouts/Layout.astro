gap:20px;margin-bottom:20px}.section-heading h2{font-size:clamp(1.65rem,3vw,2.25rem);line-height:1.15;margin:4px 0}.section-heading a{font-weight:750;color:#1d4ed8;text-decoration:none}.muted{color:#64748b}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.category-card{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid #dbe3ee;border-radius:18px;padding:20px;text-decoration:none;color:inherit;min-height:145px}.category-card:hover,.popular-card:hover{transform:translateY(-2px);border-color:#93c5fd;box-shadow:0 10px 28px #0f172a10}.category-icon{font-size:2rem}.category-card h3{margin:0 0 5px;font-size:1.2rem}.category-card p{margin:0 0 9px;color:#64748b;font-size:.94rem}.category-card strong{color:#1d4ed8}.popular-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.popular-card{background:#fff;border:1px solid #dbe3ee;border-radius:18px;padding:20px;text-decoration:none;color:inherit;min-height:200px}.popular-badge{font-size:.7rem;font-weight:900;color:#1d4ed8;background:#eff6ff;border-radius:999px;padding:4px 8px}.popular-card h3{margin:14px 0 8px;font-size:1.08rem}.popular-card p{color:#64748b;font-size:.92rem}.use-link{display:block;margin-top:16px;color:#1d4ed8;font-weight:800}.search-results{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.search-result{display:flex;flex-direction:column;gap:3px;background:#fff;border:1px solid #e2e8f0;border-radius:13px;padding:15px 17px;text-decoration:none;color:inherit}.search-result span{color:#64748b;font-size:.88rem}.empty-state{padding:30px;background:#fff;border:1px dashed #cbd5e1;border-radius:14px;color:#64748b}.trust-box{display:flex;justify-content:space-between;align-items:center;gap:30px;background:#0f172a;color:#fff;border-radius:24px;padding:34px}.trust-box p{color:#cbd5e1;max-width:720px}.primary-button{background:#fff;color:#0f172a;padding:13px 17px;border-radius:12px;text-decoration:none;font-weight:850;white-space:nowrap}.tool-wrap{padding:54px 0}.tool-head{max-width:820px}.tool-head h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.08}.tool-head p{color:#64748b}.tool-box{margin-top:28px;background:#fff;border:1px solid #dbe3ee;border-radius:22px;padding:28px;max-width:820px}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}label{display:grid;gap:7px;font-weight:700}input{width:100%;padding:14px;border:1px solid #cbd5e1;border-radius:11px;font:inherit;font-size:1rem}button{margin-top:22px;padding:14px 22px;border:0;border-radius:11px;background:#2563eb;color:#fff;font:inherit;font-weight:800;cursor:pointer;min-width:150px}.result{margin-top:20px;padding:18px;border-radius:13px;background:#eff6ff;color:#1e3a8a;font-weight:750;min-height:52px}.breadcrumbs{font-size:.92rem;color:#64748b;margin-bottom:25px}.prose{max-width:900px;padding:50px 0}.prose h1{font-size:clamp(2rem,5vw,3.2rem)}.prose h2{margin-top:2.4rem}.tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tool-grid .card{display:flex;flex-direction:column;gap:6px;background:#fff;border:1px solid #dbe3ee;border-radius:16px;padding:18px;text-decoration:none;color:inherit}.tool-grid .card span{color:#64748b;font-size:.92rem}.footer{padding:38px 0;display:flex;justify-content:space-between;gap:30px}.footer-links{display:flex;gap:16px;flex-wrap:wrap}.footer-links a{color:#cbd5e1;text-decoration:none}footer{margin-top:80px;background:#0f172a;color:#fff}footer p{color:#94a3b8;margin:.3rem 0}@media(max-width:900px){.category-grid{grid-template-columns:repeat(2,1fr)}.popular-grid{grid-template-columns:repeat(2,1fr)}.tool-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.nav{align-items:flex-start;padding:12px 0}.nav nav{justify-content:flex-end}.nav nav a{padding:8px;font-size:.85rem}.category-grid,.popular-grid,.search-results,.tool-grid{grid-template-columns:1fr}.hero-inner{padding:52px 0 40px}.hero-inner h1{font-size:2.45rem}.section{padding:40px 0}.trust-box{flex-direction:column;align-items:flex-start}.form-grid{grid-template-columns:1fr}.footer{flex-direction:column}}
</style>