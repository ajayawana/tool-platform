---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page not found | Ozarbox" description="The Ozarbox page you requested could not be found.">
  <section class="hero container">
    <div class="eyebrow">404</div>
    <h1>Page not found.</h1>
    <p>The page may have moved or the URL may be incorrect. Use the Ozarbox tool library to find what you need.</p>
    <p style="margin-top:24px"><a href={base}>← Back to Ozarbox</a></p>
  </section>
</Layout>
