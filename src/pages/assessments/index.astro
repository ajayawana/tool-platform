---
import Layout from '../../layouts/Layout.astro';
import registry from '../../data/assessment-registry.json';

const base = import.meta.env.BASE_URL;
const domains = registry.domains;
const instruments = registry.instruments;
const usable = instruments.filter((item) => item.route);
const countsByDomain = domains.map((domain) => ({
  ...domain,
  count: instruments.filter((item) => item.domains.some((d) => d.id === domain.id)).length,
}));
type DeploymentStatus = 'implemented-unvalidated' | 'catalogue-only' | 'permission-review' | 'restricted' | 'disabled';
const labelForStatus = (status: DeploymentStatus): string => ({
  'implemented-unvalidated': 'Available · unvalidated',
  'catalogue-only': 'Catalogue only',
  'permission-review': 'Permission / clinical review',
  restricted: 'Restricted workflow',
  disabled: 'Disabled',
}[status] || 'Review required');
---
<Layout title="Psychological Assessment Centre | Ozarbox" description="A governed catalogue of psychological and health assessment instruments with transparent evidence, permission, and implementation status.">
  <section class="container assessment-centre" aria-labelledby="page-title">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a> / Psychological assessment centre</nav>
    <header class="page-heading">
      <p class="eyebrow">Ozarbox · Assessment library</p>
      <h1 id="page-title">Psychological Assessment Centre</h1>
      <p class="lead">Find measures by purpose, read what they are designed to measure, and check whether a version is actually available. Each instrument has its own identity, permissions and scoring rules—there is no invented all-in-one mental-health score.</p>
      <div class="catalogue-stats">
        <div><strong>{instruments.length}</strong><span>unique instruments indexed</span></div>
        <div><strong>{domains.length}</strong><span>assessment domains</span></div>
        <div><strong>{usable.length}</strong><span>implemented screens</span></div>
      </div>
    </header>

    <aside class="notice notice-critical" aria-labelledby="clinical-warning">
      <h2 id="clinical-warning">Read before using a score clinically</h2>
      <p><strong>This catalogue is not a claim of clinical validation or institutional approval.</strong> The original instrument may be validated while this website's particular implementation remains unvalidated.</p>
      <p>Only modules marked “Available · unvalidated” have a questionnaire and deterministic scoring route here. They are still screening tools, not diagnoses, and have not been independently validated as website software. Everything else is catalogue-only or held for permission, evidence, qualifications or clinical-governance review.</p>
      <p>Ozarbox does not monitor patient answers, alert a clinician or replace a clinical interview. Do not use any score alone to make diagnosis, treatment, suicide-risk disposition, emergency or employment decisions.</p>
    </aside>

    <section class="domain-section" aria-labelledby="domains-heading">
      <div class="section-title-row"><div><p class="eyebrow">Browse by domain</p><h2 id="domains-heading">Assessment domains</h2></div></div>
      <div class="domain-grid">
        {countsByDomain.map((domain) => (
          <a class="domain-card" href={'#domain-' + domain.id}>
            <span class="domain-count">{domain.count}</span>
            <strong>{domain.label}</strong>
            <span>{domain.purpose}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-heading">
      <div class="section-title-row"><div><p class="eyebrow">Search the register</p><h2 id="catalogue-heading">All listed instruments</h2></div><p class="muted">Filters run in your browser</p></div>
      <div class="filters">
        <label for="instrument-search">Search instruments
          <input id="instrument-search" type="search" placeholder="Name, purpose, domain or status" autocomplete="off" />
        </label>
        <label for="domain-filter">Domain
          <select id="domain-filter">
            <option value="">All domains</option>
            {domains.map((domain) => <option value={domain.id}>{domain.label}</option>)}
          </select>
        </label>
        <label for="status-filter">Availability
          <select id="status-filter">
            <option value="">All statuses</option>
            <option value="implemented-unvalidated">Available · unvalidated</option>
            <option value="catalogue-only">Catalogue only</option>
            <option value="permission-review">Permission / clinical review</option>
            <option value="restricted">Restricted workflow</option>
            <option value="disabled">Disabled</option>
          </select>
        </label>
      </div>
      <p id="filter-count" class="filter-count" role="status" aria-live="polite">{instruments.length} instruments listed</p>

      <div class="instrument-grid" id="instrument-grid">
        {instruments.map((instrument) => {
          const domainIds = instrument.domains.map((domain) => domain.id).join(' ');
          const domainLabels = instrument.domains.map((domain) => domain.label).join(' ');
                    return (
            <article
              class="instrument-card"
              data-instrument-id={instrument.instrument_id}
              data-domain={domainIds}
              data-status={instrument.deployment_status}
              data-search={(instrument.official_name + ' ' + instrument.main_purpose + ' ' + domainLabels + ' ' + instrument.permission_status + ' ' + instrument.deployment_status).toLowerCase()}
            >
              <div class="instrument-card-top">
                <span class={'status status-' + instrument.deployment_status}>{labelForStatus(instrument.deployment_status)}</span>
                <span class="instrument-id">{instrument.instrument_id}</span>
              </div>
              <h3>{instrument.official_name}</h3>
              <p class="instrument-purpose">{instrument.main_purpose}</p>
              <dl>
                <div><dt>Administration</dt><dd>{instrument.administration_mode}</dd></div>
                <div><dt>Version / language</dt><dd>{instrument.version} · {instrument.language}</dd></div>
                <div><dt>Rights and permissions</dt><dd>{instrument.content_rights}</dd></div>
              </dl>
              {instrument.route ? (
                <a class="instrument-action" href={base + instrument.route.replace(/^\//, '')}>Open this assessment →</a>
              ) : (
                <p class="catalogue-only-note">No questionnaire or score is provided for this entry. Verify the exact version, rights, scoring and intended-use requirements before implementation.</p>
              )}
              {instrument.evidence_sources.length > 0 && (
                <details class="source-links">
                  <summary>Official source and evidence links</summary>
                  <ul>{instrument.evidence_sources.map((source) => <li><a href={source} target="_blank" rel="noopener noreferrer">{source}</a></li>)}</ul>
                </details>
              )}
            </article>
          );
        })}
      </div>
      <p id="no-matches" hidden class="empty-state">No instruments match those filters. Try a broader search or select “All domains”.</p>
    </section>

    <section class="governance" aria-labelledby="governance-heading">
      <p class="eyebrow">How we govern this library</p>
      <h2 id="governance-heading">Why some tests are listed but not enabled</h2>
      <p>Many professionally used measures are copyrighted, qualification-controlled, interview-based, norm-dependent or subject to translation restrictions. A free PDF is not automatically permission to embed it in a commercial website. Clinician-only protocols and secure cognitive test items must not be cloned as public quizzes.</p>
      <p>Before enabling a module, Ozarbox needs an instrument-specific version record, authoritative item/scoring source, rights review, language and population review, deterministic scoring tests, safety handling, accessibility evaluation and a documented human go/no-go review. A passing build is not clinical validation.</p>
      <p><a href={base + 'privacy/'}>Read the privacy policy</a> · <a href="https://github.com/ajayawana/tool-platform/blob/main/src/data/assessment-registry.json" target="_blank" rel="noopener noreferrer">View the machine-readable registry</a> · <a href="https://github.com/ajayawana/tool-platform/blob/main/docs/phq9-verification.md" target="_blank" rel="noopener noreferrer">PHQ-9 verification report</a></p>
    </section>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('#instrument-search');
    const domain = document.querySelector<HTMLSelectElement>('#domain-filter');
    const status = document.querySelector<HTMLSelectElement>('#status-filter');
    const cards = [...document.querySelectorAll<HTMLElement>('.instrument-card')];
    const count = document.querySelector<HTMLElement>('#filter-count');
    const empty = document.querySelector<HTMLElement>('#no-matches');

    function applyFilters() {
      const query = search?.value.trim().toLowerCase() ?? '';
      const selectedDomain = domain?.value ?? '';
      const selectedStatus = status?.value ?? '';
      let visible = 0;
      for (const card of cards) {
        const matches = (!query || (card.dataset.search ?? '').includes(query))
          && (!selectedDomain || (card.dataset.domain ?? '').split(' ').includes(selectedDomain))
          && (!selectedStatus || card.dataset.status === selectedStatus);
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = visible + ' of ' + cards.length + ' instruments shown';
      if (empty) empty.hidden = visible !== 0;
    }
    search?.addEventListener('input', applyFilters);
    domain?.addEventListener('change', applyFilters);
    status?.addEventListener('change', applyFilters);
    applyFilters();
  </script>

  <style>
    .assessment-centre{padding:38px 0 12px}
    .page-heading{max-width:900px;padding:15px 0 22px}
    .page-heading h1{font-size:clamp(2.25rem,5vw,3.75rem);line-height:1.05;letter-spacing:-.04em;margin:.25rem 0 1rem}
    .lead{font-size:1.13rem;color:#475569;max-width:850px}
    .catalogue-stats{display:flex;gap:14px;flex-wrap:wrap;margin:24px 0}
    .catalogue-stats div{display:flex;flex-direction:column;padding:13px 17px;border:1px solid #dbe3ee;border-radius:12px;background:#fff;min-width:150px}
    .catalogue-stats strong{font-size:1.6rem;line-height:1.15}
    .catalogue-stats span{font-size:.85rem;color:#64748b}
    .notice{padding:20px 22px;border-radius:16px;max-width:1000px;border:1px solid #fed7aa;background:#fffaf0;color:#7c2d12}
    .notice h2{margin:0 0 8px;font-size:1.2rem}
    .notice p{margin:.6rem 0}
    .domain-section,.catalogue,.governance{padding:34px 0}
    .section-title-row{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:18px}
    .section-title-row h2,.governance h2{margin:.2rem 0;font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.15}
    .domain-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .domain-card{display:flex;flex-direction:column;gap:6px;padding:17px;border:1px solid #dbe3ee;border-radius:14px;text-decoration:none;color:inherit;background:#fff;min-height:155px}
    .domain-card:hover{border-color:#93c5fd;box-shadow:0 6px 20px #0f172a0b}
    .domain-count{align-self:flex-start;background:#eff6ff;color:#1d4ed8;border-radius:8px;padding:1px 8px;font-weight:850}
    .domain-card strong{line-height:1.25}
    .domain-card span:last-child{font-size:.88rem;color:#64748b}
    .filters{display:grid;grid-template-columns:2fr 1.25fr 1fr;gap:12px;padding:18px;background:#fff;border:1px solid #dbe3ee;border-radius:15px}
    .filters label{display:grid;gap:6px;font-weight:750;font-size:.92rem}
    .filters input,.filters select{min-width:0;border:1px solid #cbd5e1;border-radius:10px;padding:12px;background:white;color:#0f172a;font:inherit}
    .filter-count{font-size:.9rem;color:#64748b;margin:12px 0}
    .instrument-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
    .instrument-card{background:#fff;border:1px solid #dbe3ee;border-radius:15px;padding:18px;min-width:0}
    .instrument-card[hidden]{display:none!important}
    .instrument-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}
    .status{font-size:.74rem;font-weight:850;line-height:1.35;padding:4px 8px;border-radius:999px;background:#e2e8f0;color:#334155}
    .status-implemented-unvalidated{background:#fef3c7;color:#92400e}
    .status-permission-review{background:#ffedd5;color:#9a3412}
    .status-restricted{background:#fee2e2;color:#991b1b}
    .status-catalogue-only,.status-disabled{background:#e2e8f0;color:#475569}
    .instrument-id{font-size:.75rem;color:#64748b;overflow-wrap:anywhere}
    .instrument-card h3{font-size:1.12rem;line-height:1.3;margin:13px 0 6px}
    .instrument-purpose{color:#475569;margin:.35rem 0 1rem}
    .instrument-card dl{margin:0}
    .instrument-card dl div{border-top:1px solid #f1f5f9;padding:8px 0}
    .instrument-card dt{font-size:.78rem;text-transform:uppercase;letter-spacing:.03em;font-weight:850;color:#64748b}
    .instrument-card dd{margin:2px 0 0;font-size:.88rem;overflow-wrap:anywhere}
    .instrument-action{display:inline-block;margin-top:13px;font-weight:850;color:#1d4ed8;text-decoration:underline}
    .catalogue-only-note{font-size:.88rem;color:#64748b;border-left:3px solid #cbd5e1;padding-left:10px;margin-top:13px}
    .source-links{margin-top:14px;border-top:1px solid #e2e8f0;padding-top:10px;font-size:.84rem}
    .source-links summary{font-weight:750;cursor:pointer}
    .source-links ul{padding-left:20px}
    .source-links a{overflow-wrap:anywhere}
    .governance{max-width:940px;line-height:1.7;color:#334155}
    .governance a{color:#1d4ed8;font-weight:750}
    .empty-state{padding:24px;background:white;border:1px dashed #cbd5e1;border-radius:14px;color:#64748b}
    button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #f59e0b;outline-offset:3px}
    @media(max-width:900px){.domain-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.filters{grid-template-columns:1fr 1fr}.filters label:first-child{grid-column:1/-1}}
    @media(max-width:600px){.domain-grid,.instrument-grid,.filters{grid-template-columns:1fr}.filters label:first-child{grid-column:auto}.section-title-row{align-items:flex-start;flex-direction:column}.catalogue-stats div{flex:1 1 130px}.assessment-centre{padding-top:24px}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
    @media print{.site-header,footer,.filters,.domain-section,.notice,.instrument-action,.source-links{display:none!important}.assessment-centre{padding:0}.instrument-grid{display:block}.instrument-card{break-inside:avoid;margin:0 0 12px}}
  </style>
</Layout>
