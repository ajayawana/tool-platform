---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools';
const base = import.meta.env.BASE_URL;
export function getStaticPaths() { return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
---
<Layout title={`${tool.title} | Ozarbox`} description={tool.description} robots="noindex,follow">
  <section class="tool-wrap container">
    <div class="breadcrumbs"><a href={base}>Home</a> / <a href={`${base}niche/`}>Tools</a> / {tool.title}</div>
    <div class="tool-head"><div class="eyebrow">Legacy calculator URL</div><h1>{tool.title}</h1><p>{tool.description}</p></div>
    <div class="tool-box">
      <p>This older Ozarbox URL is retained for compatibility. The current SEO-focused tool library is available in the professional tools section.</p>
      <a href={`${base}niche/${tool.slug}/`}><button type="button">Open the current Ozarbox tool</button></a>
    </div>
  </section>
</Layout>
